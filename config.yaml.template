service:
  host: "127.0.0.1"
  port: 7001
  reload: false
  log_level: "INFO"

data:
  data_dir: "data"

index:
  chunking:
    chunk_size: 500
    overlap: 0.3

  embeddings:
    model_name: "cc.en.300.bin"
    dimension: 300

  storage:
    db_filename: "minirag.db"

  faiss:
    # Exact: IndexFlatIP (or Flat). Approximate: IVF<nlist>,Flat, e.g. IVF64,Flat.
    # Changing the index type requires rebuilding the corpus index.
    index_type: "IndexFlatIP"
    # Number of IVF partitions searched; unused for exact Flat indexes.
    nprobe: 1

  tantivy:
    # ISO language code or full language name; used by the optional stemmer.
    # Changing language/stemming requires rebuilding the corpus index.
    language: "en"
    stemming: true

search:
  hybrid:
    alpha: 0.65

  dense: {}

  sparse: {}

  reranking:
    enabled: false
    model_name: "cross-encoder/ms-marco-MiniLM-L12-v2"
    candidate_multiplier: 3
